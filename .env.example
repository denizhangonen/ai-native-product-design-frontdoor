# Supabase transaction pooler (port 6543), user frontdoor_app.<project-ref>
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Annual spend at or below this is guided on the spot; above it goes to procurement
POLICY_THRESHOLD_USD_PER_YEAR=1000
# Linked from the guided reply
POLICY_URL=https://example.com/spending-policy

# fake = fixture answers, no network. openai = real parsing, needs OPENAI_API_KEY.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

# Slack app credentials. Leave unset until the app is installed; the rest of the app still runs.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Below this the message is treated as not understood rather than guessed at
MIN_PARSE_CONFIDENCE=0.6

# Email. fake keeps everything in memory; resend sends and receives for real.
EMAIL_PROVIDER=fake
# Must be an address on a domain verified in Resend.
EMAIL_FROM=Frontdoor <intake@frontdoor.example.com>
# Replies land here, so it must be a domain with receiving turned on in Resend.
EMAIL_REPLY_TO=intake@frontdoor.example.com
# Comma separated. Only these addresses may decide. Empty means nobody can.
PROCUREMENT_EMAILS=procurement@example.com

# Needed when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Signing secret of the email.received webhook, in whsec_ form.
RESEND_WEBHOOK_SECRET=
# Shared secret for the inbound webhook when EMAIL_PROVIDER=fake.
EMAIL_INBOUND_SECRET=

# Vercel sets this for scheduled calls to /api/cron/prune. Unset means the route refuses everyone.
CRON_SECRET=
